{
  "name": "appium-android-project",
  "version": "1.0.0",
  "private": true,
  "description": "Appium UiAutomator2 + Cucumber-JS + TypeScript + JSON-driven data + MCP + HTML / Excel reports.",
  "scripts": {
    "test":         "node src/test/ts/reporting/run-and-report.js --config cucumber.config.js",
    "test:payto":   "node src/test/ts/reporting/run-and-report.js --config cucumber.config.js",
    "test:login":   "node src/test/ts/reporting/run-and-report.js --config cucumber.config.js --profile login",
    "test:request": "node src/test/ts/reporting/run-and-report.js --config cucumber.config.js --profile request",
    "test:merchant": "node src/test/ts/reporting/run-and-report.js --config cucumber.config.js --profile merchant",
    "test:all":     "node src/test/ts/reporting/run-and-report.js --config cucumber.config.js --profile all",
    "test:dry":     "cucumber-js --config cucumber.config.js --dry-run",
    "report:html": "node src/test/ts/reporting/generate-report.js",
    "report:excel": "ts-node src/test/ts/reporting/generate-excel.ts",
    "report": "npm run report:html && npm run report:excel",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.1.1",
    "@types/node": "^22.10.5",
    "exceljs": "^4.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "webdriverio": "^9.27.0"
  }
}
