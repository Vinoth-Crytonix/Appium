{
  "name": "appium-android-project",
  "version": "1.0.0",
  "private": true,
  "description": "Appium UiAutomator2 + Cucumber-JS + TypeScript + JSON-driven data + MCP + HTML / Excel reports.",
  "scripts": {
    "test":           "ts-node src/test/ts/runner/runner.ts",
    "test:sequence":  "ts-node src/test/ts/runner/runner.ts src/test/resources/features/payTo/payTo.feature src/test/resources/features/validation src/test/resources/features/requestMoney/requestMoney.feature src/test/resources/features/validation src/test/resources/features/merchantPayment/merchantPayment.feature src/test/resources/features/validation src/test/resources/features/myanmarPay/myanmarPayPersonal.feature src/test/resources/features/myanmarPay/myanmarPayHistory.feature src/test/resources/features/validation src/test/resources/features/electricity/electricity.feature src/test/resources/features/validation src/test/resources/features/recentTransactions/recentTransactions.feature src/test/resources/features/validation",

    "test:parallel:2": "ts-node src/test/ts/runner/runner.ts --parallel 2",
    "test:parallel:3": "ts-node src/test/ts/runner/runner.ts --parallel 3",

    "test:flows":     "cucumber-js --config cucumber.config.js --profile flows",

    "_comment:securityLayer": "Security-layer suite. Cycle count is a RUNTIME flag, not a file edit: append -- --count 100. Add --assign with several feature paths to give each device its own feature, run concurrently.",

    "_comment:soak": "All 4 security-layer features, one per device, each on its own Appium server. Append the mode: -- --duration 5h | -- --count 100 | -- --count 5000 --until-failure. Start the servers first with `npm run appium:servers`.",
    "appium:servers": "ts-node src/test/ts/runner/startServers.ts",
    "_comment:run": "Named entry points. Append the mode after `--`: --duration 5h | --count 100 | --count 5000 --until-failure. SecurityLayer runs the whole folder (one feature per device); the per-feature scripts run that ONE feature across every connected device. Add --parallel 1 to pin a single-feature run to one device. Start servers first: npm run appium:servers",
    "SecurityLayer":      "ts-node src/test/ts/runner/runner.ts --no-audit --assign --server-per-device src/test/resources/features/securityLayer",
    "personalProfile":    "ts-node src/test/ts/runner/runner.ts --no-audit --assign --server-per-device src/test/resources/features/securityLayer/personalProfile.feature",
    "businessProfile":    "ts-node src/test/ts/runner/runner.ts --no-audit --assign --server-per-device src/test/resources/features/securityLayer/businessProfile.feature",
    "voucherLogin":       "ts-node src/test/ts/runner/runner.ts --no-audit --assign --server-per-device src/test/resources/features/securityLayer/voucherLogin.feature",
    "validateAppVersion": "ts-node src/test/ts/runner/runner.ts --no-audit --assign --server-per-device src/test/resources/features/securityLayer/validateAppVersion.feature",
    "run:feature":        "ts-node src/test/ts/runner/runner.ts --no-audit --assign --server-per-device",

    "test:securityLayer": "ts-node src/test/ts/runner/runner.ts --no-audit --assign src/test/resources/features/securityLayer/voucherLogin.feature src/test/resources/features/securityLayer/validateAppVersion.feature",
    "test:voucher":   "ts-node src/test/ts/runner/runner.ts --no-audit src/test/resources/features/securityLayer/voucherLogin.feature",
    "test:personalProfile": "ts-node src/test/ts/runner/runner.ts --no-audit --parallel 1 src/test/resources/features/securityLayer/personalProfile.feature",
    "test:businessProfile": "ts-node src/test/ts/runner/runner.ts --no-audit --parallel 1 src/test/resources/features/securityLayer/businessProfile.feature",
    "test:appVersion": "ts-node src/test/ts/runner/runner.ts --no-audit src/test/resources/features/securityLayer/validateAppVersion.feature",
    "test:personalProfile": "ts-node src/test/ts/runner/runner.ts --no-audit src/test/resources/features/securityLayer/personalProfile.feature",

    "test:login":     "ts-node src/test/ts/runner/runner.ts src/test/resources/features/login/login.feature",
    "test:login:loop": "ts-node src/test/ts/runner/runner.ts --no-audit src/test/resources/features/securityLayer/voucherLogin.feature",
    "test:login:loop:audit": "ts-node src/test/ts/runner/runner.ts src/test/resources/features/securityLayer/voucherLogin.feature",
    "test:payto":     "ts-node src/test/ts/runner/runner.ts src/test/resources/features/payTo/payTo.feature",
    "test:merchant":  "ts-node src/test/ts/runner/runner.ts src/test/resources/features/merchantPayment/merchantPayment.feature",
    "test:request":   "ts-node src/test/ts/runner/runner.ts src/test/resources/features/requestMoney/requestMoney.feature",
    "test:recent":    "ts-node src/test/ts/runner/runner.ts src/test/resources/features/recentTransactions/recentTransactions.feature",
    "test:myanmar":   "ts-node src/test/ts/runner/runner.ts src/test/resources/features/myanmarPay/myanmarPayPersonal.feature",
    "test:myanmar:history": "ts-node src/test/ts/runner/runner.ts src/test/resources/features/myanmarPay/myanmarPayHistory.feature",
    "test:electricity": "ts-node src/test/ts/runner/runner.ts src/test/resources/features/electricity/electricity.feature",
    "test:electricity:seq": "node src/test/ts/runner/runElectricitySequence.js",

    "test:ui":           "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/uiValidation.feature",
    "test:functional":   "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/functionalValidation.feature",
    "test:navigation":   "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/navigationValidation.feature",
    "test:api":          "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/apiDataValidation.feature",
    "test:device":       "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/deviceValidation.feature",
    "test:permission":   "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/permissionValidation.feature",
    "test:network":      "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/networkValidation.feature",
    "test:security":     "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/securityValidation.feature",
    "test:performance":  "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/performanceValidation.feature",
    "test:notification": "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/notificationValidation.feature",
    "test:interruption": "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/interruptionValidation.feature",
    "test:localization": "ts-node src/test/ts/runner/runner.ts src/test/resources/features/validation/localizationValidation.feature",

    "test:stringValidation:parity": "ts-node src/test/ts/reporting/stringValidationParity.ts",
    "test:stringValidation:en":    "ts-node src/test/ts/runner/runStringValidationAudit.ts --lang en",
    "test:stringValidation:my":    "ts-node src/test/ts/runner/runStringValidationAudit.ts --lang my",
    "test:stringValidation:audit": "ts-node src/test/ts/runner/runStringValidationAudit.ts --lang auto",

    "runner":         "ts-node src/test/ts/runner/runner.ts",
    "test:dry":       "cucumber-js --config cucumber.config.js --dry-run",
    "report:html":    "node src/test/ts/reporting/generate-report.js",
    "report:excel":   "ts-node src/test/ts/reporting/generate-excel.ts",
    "report":         "npm run report:html && npm run report:excel",
    "typecheck":      "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.1.1",
    "@types/node": "^22.10.5",
    "exceljs": "^4.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "webdriverio": "^9.27.0"
  }
}
